{
  "name": "t3code-cli",
  "version": "0.1.0",
  "description": "Create and drive T3 Code threads from the command line",
  "type": "module",
  "bin": { "t3c": "./dist/bin.js" },
  "files": ["dist"],
  "engines": { "node": ">=22.16" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/*.test.ts",
    "t3c": "node --experimental-strip-types src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
