{
  "name": "t3code-cli",
  "version": "0.1.0",
  "description": "Create and drive T3 Code threads from the command line",
  "type": "module",
  "bin": {
    "t3c": "./src/bin.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "sh scripts/contracts.sh",
    "typecheck": "sh scripts/contracts.sh && tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "t3c": "node src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "effect": "4.0.4",
    "typescript": "^5.9.2"
  },
  "config": {
    "t3code": "v0.0.46-nightly.20261014.3132"
  }
}
